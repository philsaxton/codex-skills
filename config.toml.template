# Install this repository at `.agents/skills/`, then copy this file or append its
# contents to `.codex/config.toml` in the consuming project root. Every implemented
# skill starts disabled so you can enable them gradually. Restart Codex after changes.
# These relative paths assume that layout. If your Codex version does not resolve
# overrides from the project root, prefix each path with that project's absolute root.

[[skills.config]]
path = ".agents/skills/coordinator/"
enabled = false

[[skills.config]]
path = ".agents/skills/contract-author/"
enabled = false

[[skills.config]]
